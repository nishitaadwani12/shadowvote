# Server
PORT=8080
HOST=0.0.0.0

# Postgres (Neon free tier — https://neon.tech). Optional for P0 (health check runs without it).
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Google Gemini free tier — https://aistudio.google.com/apikey (no card required). Optional until P2.
GEMINI_API_KEY=

# Web (Vite) — URL the browser uses to reach the WebSocket server.
VITE_WS_URL=ws://localhost:8080/ws
